give @s minecraft:written_book 1 0 {title:"RV · Памятка",author:"RV",generation:0,rvGuide:1b,rvGuideVersion:3,pages:["{\"text\":\"RV · Начало\\n\\nT — чат\\nE — инвентарь\\nJ — карта\\n\\nМеню:\\n/trigger menu set 1\\n\\nПотерял книгу?\\nМеню → «Книга»\\n/trigger wbook set 1\"}","{\"text\":\"Первый запуск\\n\\nВ «Играть» выбери\\nмышь и клавиатуру\\nлибо USB-пульт.\\n\\nДля пульта выбери\\nустройство и\\nпроверь оси. Затем\\nвыбери сервер.\\n\\nНастройку можно\\nповторить в\\nлаунчере.\"}","{\"text\":\"Спавн\\n\\nОбщая площадка:\\nX: 0\\nY: 65\\nZ: -210\\n\\nВернуться:\\n/trigger spawn set 1\\n\\nДля всех игроков.\\nКоманду выбери в\\nменю.\"}","{\"text\":\"Снаряжение\\n\\nМеню → Набор\\n/trigger kit set 1\\n\\nM4, боеприпасы, еда,\\nброня, планшет.\\n\\nДо 3 боевых FPV; по\\nодному Герань и\\nFP-1.\"}","{\"text\":\"Пополнение\\n\\n/trigger drone set 1\\nДо 3 боевых FPV.\\n\\n/trigger wing set 1\\nГерань и FP-1.\\n\\nНужны свободные\\nслоты. После выдачи\\nподожди 5 секунд.\"}","{\"text\":\"Оружие\\n\\nЛКМ — огонь\\nПКМ — прицел\\nR — перезарядка\\n\\nНе сработало?\\nПроверь назначения\\nв Настройки →\\nУправление.\"}","{\"text\":\"Танк\\n\\nПКМ — сесть.\\nW/A/S/D — ехать.\\nМышь — навести.\\nЛКМ — выстрел.\\n\\nG / СКМ — оружие.\\nZ — приближение.\\nY — выйти.\\n\\nПо умолчанию.\\nТекущие — на HUD.\"}","{\"text\":\"Боекомплект\\n\\nR — перезарядка.\\nI — груз техники.\\n\\nПроверь боекомплект\\nи выбранное оружие\\nна HUD.\\n\\nПассажирское место\\nможет не управлять\\nпушкой.\"}","{\"text\":\"Попадание\\n\\nПОПАДАНИЕ — без\\nпотери HP.\\n\\nУРОН −N — минус N HP.\\n\\nУНИЧТОЖЕНО — цель\\nразрушена.\\n\\nЭту метку\\nподтверждает\\nсервер.\"}","{\"text\":\"Ранения\\n\\nВыйди из техники.\\nH — осмотр ран.\\n\\nЗдоровье рук, ног,\\nголовы и тела\\nучитывается\\nотдельно.\\n\\nПроверь клавишу:\\nНастройки →\\nУправление\\nFirst Aid\"}","{\"text\":\"Бинты\\n\\nВозьми бинт или\\nпластырь. Нажми ПКМ.\\n\\nУдерживай кнопку\\nраненой части тела\\nдо конца.\\n\\nЗдоровье\\nвосстанавливается\\nпостепенно. Пополни\\nзапас через «Набор».\"}","{\"text\":\"FPV-коптер\\n\\nПоставь FPV. Возьми\\nпланшет и нажми ПКМ\\nпо коптеру.\\n\\nМышь — смотреть и\\nповорачивать.\\nShift — выйти.\\n\\nEasy — обычный\\nрежим для мыши и\\nклавиатуры.\"}","{\"text\":\"Полёт · Easy\\n\\nW/S — вперёд/назад\\nA/D — влево/вправо\\nSpace — вверх\\nЛевый Ctrl — вниз\\n\\nОтпусти кнопки:\\nкоптер тормозит и\\nзависает.\\n\\nЭто клавиши по\\nумолчанию. Текущие\\n— на HUD.\"}","{\"text\":\"Взлёт · Easy\\n\\nПосле подключения\\nна земле нажми\\nSpace для взлёта.\\n\\nПри потере фокуса\\nокна двигатель\\nотключается. Коптер\\nснижается.\\n\\nВернись в окно и\\nнажми Space, чтобы\\nпродолжить полёт.\"}","{\"text\":\"Боевой FPV\\n\\nПосле взлёта удар о\\nтехнику или блоки\\nвызывает взрыв.\\n\\nСтавь его на ровное\\nместо. Для первых\\nполётов используй\\nучебную зону.\"}","{\"text\":\"После переворота\\n\\nВыйди из\\nуправления. Нажми\\nShift + ПКМ\\nпланшетом по\\nсвободному дрону на\\nземле.\\n\\nДрон выровняется,\\nгаз сбросится. В\\nвоздухе это не\\nработает.\"}","{\"text\":\"Герань и FP-1\\n\\nНужна ровная\\nсвободная полоса.\\nПоставь самолёт,\\nвозьми планшет и\\nнажми ПКМ по нему.\\n\\nW — набрать газ.\\nМышь — наклон.\\nS — убавить газ.\\nY — выйти.\"}","{\"text\":\"Полёт самолёта\\n\\nA/D — крен\\nвлево/вправо.\\n\\nСамолёту нужна\\nскорость. Он не\\nзависает.\\n\\nПри выходе газ\\nсбрасывается.\\nСамолёт продолжает\\nдвигаться и\\nснижается.\"}","{\"text\":\"Пульт · F8\\n\\nПодключи USB-пульт\\nв режиме Joystick.\\n\\nВ F8 выбери\\nустройство и оси:\\nкрен, тангаж,\\nповорот, газ.\\n\\nОткалибруй центр и\\nполный ход. Проверь\\nинверсию и сохрани.\"}","{\"text\":\"Режимы пульта\\n\\nAngle выравнивает\\nкоптер, когда\\nотпускаешь стики.\\n\\nAcro сохраняет\\nнаклон: выравнивай\\nсам.\\n\\nВыбор — в F8.\\nНа клавиатуре начни\\nс Easy.\"}","{\"text\":\"Перед взлётом\\n\\nНа пульте опусти газ\\nдо минимума. На\\nгеймпаде верни стик\\nгаза в центр.\\n\\nПри потере USB или\\nфокуса окна газ\\nсбрасывается.\\n\\nЕсли устройство не\\nнайдено, проверь USB\\nJoystick и F8.\"}","{\"text\":\"Качество\\n\\nВ лаунчере открой\\nНастройки → Профиль.\\n\\nLow — меньше\\nэффектов.\\nBalanced — обычный.\\nQuality — подробнее.\\n\\nЕсли мало FPS, начни\\nс Low.\"}","{\"text\":\"Если мало FPS\\n\\nВыключи шейдеры.\\nНачни с дальности\\n4–6 чанков, частицы\\n— уменьшенные.\\n\\nПроверь FPS через\\nF3. Меняй настройки\\nпо одной.\\n\\nЗакрой лишние\\nприложения.\"}","{\"text\":\"FPS или сервер?\\n\\nКартинка идёт\\nрывками, FPS падает\\n— снижай графику.\\n\\nКартинка плавная, но\\nблоки возвращаются\\nи действия\\nзапаздывают —\\nпроверь связь и\\nсервер.\"}","{\"text\":\"Звуки окружения\\n\\nФон природы задаёт\\nAmbientSounds.\\nГромкость зависит\\nот профиля лаунчера.\\n\\nЕсли фон мешает\\nслышать мотор и\\nвыстрелы, начни с\\nLow.\\n\\nГромкость игры:\\nНастройки → Звуки\"}","{\"text\":\"Инвентарь\\n\\nMouse Tweaks\\nпомогает\\nперекладывать вещи\\nв инвентаре.\\n\\nЗакрой его перед\\nполётом, стрельбой\\nили лечением.\\n\\nДля нового набора\\nнужны свободные\\nслоты.\"}","{\"text\":\"ModularWarfare\\n\\nЛКМ — огонь\\nПКМ — прицел\\nR — перезарядка\\nV — режим огня\\n\\nN — осмотреть\\nоружие.\\nU — извлечь магазин.\\nF6 — фонарь.\\n\\nЭто клавиши новой\\nоружейной системы.\"}","{\"text\":\"Магазины\\n\\nДля ModularWarfare\\nнужны свои\\nмагазины и патроны.\\n\\nПатроны Techguns к\\nэтому оружию не\\nподходят.\\n\\nЕсли R не работает,\\nпроверь нужный\\nмагазин в инвентаре.\"}"]}
